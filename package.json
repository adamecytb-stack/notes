{
  "name": "dream-journal",
  "version": "0.1.0",
  "private": true,
  "description": "A private, end-to-end encrypted dream journal for two people.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute dreams --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute dreams --local --file=./schema.sql",
    "seed": "node test/seed.mjs",
    "test:api": "node test/api.test.mjs",
    "test:flows": "node test/flows.test.mjs",
    "test:ai": "node test/ai.test.mjs",
    "stub:gemini": "node test/gemini-stub.mjs",
    "shots": "node test/screenshots.mjs",
    "icons": "python3 scripts/make-icons.py",
    "test:lucid": "node test/lucid.test.mjs",
    "test:sharing": "node test/sharing.test.mjs",
    "migrate": "node scripts/migrate.mjs",
    "migrate:remote": "node scripts/migrate.mjs --remote",
    "test:push": "node test/push.test.mjs",
    "stub:push": "node test/push-stub.mjs",
    "vapid": "node scripts/vapid-keys.mjs",
    "test:update": "node test/update.test.mjs",
    "test:tonight": "node test/tonight.test.mjs",
    "test:responsive": "node test/responsive.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "wrangler": "^4.20.0"
  }
}
