{
  "name": "dream-journal",
  "version": "0.1.0",
  "private": true,
  "description": "A private, end-to-end encrypted dream journal for two people.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute dreams --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute dreams --local --file=./schema.sql",
    "seed": "node test/seed.mjs",
    "test:api": "node test/api.test.mjs",
    "test:flows": "node test/flows.test.mjs",
    "shots": "node test/screenshots.mjs",
    "icons": "python3 scripts/make-icons.py"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "wrangler": "^4.20.0"
  }
}
